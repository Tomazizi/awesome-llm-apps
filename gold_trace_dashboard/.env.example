# ── Gold Trace: every key is optional ────────────────────────────────
# Without keys the ingestors run the built-in simulator (mode='sim').
# With keys the same code paths write mode='live' observations.

# Price & market (pick one)
GOLDAPI_IO_KEY=            # https://www.goldapi.io  — XAU/USD spot
METALS_API_KEY=            # https://metals-api.com

# On-chain whales
ETHERSCAN_API_KEY=         # PAXG/XAUT ERC-20 transfer feed
ALCHEMY_API_KEY=           # optional RPC fallback

# Macro
FRED_API_KEY=              # DFII10 (TIPS 10y), DTWEXBGS (DXY), DCOILBRENTEU

# Alerts
TELEGRAM_BOT_TOKEN=        # from @BotFather
TELEGRAM_CHAT_ID=          # your chat/group id

# Run mode
DEMO_SPEEDUP=1             # >1 compresses daily/weekly/monthly cadence further
GOLD_TRACE_DB=             # defaults to ./data/gold_trace.db
